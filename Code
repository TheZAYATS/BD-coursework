            int choice = scanner.nextInt();
            scanner.nextLine();

            try {
                switch (choice) {
                    case 1 -> showAllRecords(tableName);
                    case 2 -> addRecord(tableName, columns, columnTypes);
                    case 3 -> updateRecord(tableName, pkColumn, pkType, columns, columnTypes);
                    case 4 -> deleteRecord(tableName, pkColumn, pkType);
                    case 5 -> searchRecord(tableName, columns);
                    case 6 -> sortRecords(tableName, columns);
