    }

    static void showAllRecords(String tableName) throws SQLException {
        String sql = "SELECT * FROM " + tableName;
        try (Connection conn = DatabaseConnection.getConnection();
             Statement stmt = conn.createStatement();
             ResultSet rs = stmt.executeQuery(sql)) {

            ResultSetMetaData meta = rs.getMetaData();
            int colCount = meta.getColumnCount();

            for (int i = 1; i <= colCount; i++) {
                System.out.printf("%-25s", meta.getColumnName(i));
            }
            System.out.println();
            System.out.println("=".repeat(colCount * 25));

            boolean hasData = false;
            while (rs.next()) {
                hasData = true;
                for (int i = 1; i <= colCount; i++) {
                    String value = rs.getString(i);
                    if (value == null) value = "NULL";
                    System.out.printf("%-25s", value.length() > 24 ? value.substring(0, 22) + "..." : value);
                }
                System.out.println();
            }

            if (!hasData) {
                System.out.println("(Нет данных)");
            }
        }
    }

    static void addRecord(String tableName, String[] columns, String[] columnTypes) throws SQLException {
        System.out.println("\n--- ДОБАВЛЕНИЕ ЗАПИСИ В " + tableName.toUpperCase() + " ---");

        StringBuilder sql = new StringBuilder("INSERT INTO " + tableName + " (");
        sql.append(String.join(", ", columns));
        sql.append(") VALUES (");
        sql.append("?, ".repeat(columns.length));
        sql.setLength(sql.length() - 2);
        sql.append(")");

        try (Connection conn = DatabaseConnection.getConnection();
             PreparedStatement ps = conn.prepareStatement(sql.toString())) {

            for (int i = 0; i < columns.length; i++) {
                System.out.print(columns[i] + ": ");
                String value = scanner.nextLine();

                if (value == null || value.trim().isEmpty()) {
                    ps.setNull(i + 1, Types.NULL);
                } else {
                    String type = columnTypes[i];
                    switch (type) {
                        case "int":
                            ps.setInt(i + 1, Integer.parseInt(value));
                            break;
                        case "numeric":
                            ps.setBigDecimal(i + 1, new java.math.BigDecimal(value));
                            break;
                        case "date":
                            ps.setDate(i + 1, java.sql.Date.valueOf(value));
                            break;
                        default:
                            ps.setString(i + 1, value);
                            break;
                    }
                }
            }

            int rows = ps.executeUpdate();
            if (rows > 0) {
                System.out.println("✓ Запись успешно добавлена!");
            } else {
                System.out.println("✗ Ошибка при добавлении!");
            }
        } catch (NumberFormatException e) {
            System.out.println("Ошибка: Неверный формат числа!");
            throw new SQLException("Ошибка преобразования типа");
        } catch (IllegalArgumentException e) {
            System.out.println("Ошибка: Неверный формат даты! Используйте ГГГГ-ММ-ДД");
            throw new SQLException("Ошибка преобразования даты");
        }
    }

    static void updateRecord(String tableName, String pkColumn, String pkType, String[] columns, String[] columnTypes) throws SQLException {
        System.out.print("\nВведите " + pkColumn + " записи для изменения: ");
        String id = scanner.nextLine();

        System.out.println("Введите новые значения (Enter - оставить без изменений):");

        StringBuilder sql = new StringBuilder("UPDATE " + tableName + " SET ");
        List<String> updateCols = new ArrayList<>();
        List<Object> values = new ArrayList<>();
        List<String> types = new ArrayList<>();

        for (int i = 0; i < columns.length; i++) {
            System.out.print(columns[i] + ": ");
            String value = scanner.nextLine();
            if (!value.isEmpty()) {
                updateCols.add(columns[i] + " = ?");
                values.add(value);
                types.add(columnTypes[i]);
            }
        }

        if (updateCols.isEmpty()) {
            System.out.println("Нет изменений для сохранения!");
            return;
        }

        sql.append(String.join(", ", updateCols));
        sql.append(" WHERE ").append(pkColumn).append(" = ");

        if (pkType.equals("int")) {
            sql.append("?::integer");
        } else {
            sql.append("?");
        }

        try (Connection conn = DatabaseConnection.getConnection();
             PreparedStatement ps = conn.prepareStatement(sql.toString())) {

            int paramIndex = 1;
            for (int i = 0; i < values.size(); i++) {
                String value = (String) values.get(i);
                String type = types.get(i);

                switch (type) {
                    case "int":
                        ps.setInt(paramIndex++, Integer.parseInt(value));
                        break;
                    case "numeric":
                        ps.setBigDecimal(paramIndex++, new java.math.BigDecimal(value));
                        break;
                    case "date":
                        ps.setDate(paramIndex++, java.sql.Date.valueOf(value));
                        break;
                    default:
                        ps.setString(paramIndex++, value);
                        break;
                }
            }

            if (pkType.equals("int")) {
                ps.setInt(paramIndex, Integer.parseInt(id));
            } else {
                ps.setString(paramIndex, id);
            }

            int rows = ps.executeUpdate();
            if (rows > 0) {
                System.out.println("✓ Запись успешно обновлена!");
            } else {
                System.out.println("✗ Запись с " + pkColumn + "=" + id + " не найдена!");
            }
        } catch (NumberFormatException e) {
            System.out.println("Ошибка: Неверный формат числа!");
        } catch (IllegalArgumentException e) {
            System.out.println("Ошибка: Неверный формат даты! Используйте ГГГГ-ММ-ДД");
        }
    }

    static void deleteRecord(String tableName, String pkColumn, String pkType) throws SQLException {
        System.out.print("\nВведите " + pkColumn + " записи для удаления: ");
        String id = scanner.nextLine();

        String sql = "DELETE FROM " + tableName + " WHERE " + pkColumn + " = ";

        if (pkType.equals("int")) {
            sql += "?::integer";
        } else {
            sql += "?";
        }

        try (Connection conn = DatabaseConnection.getConnection();
             PreparedStatement ps = conn.prepareStatement(sql)) {

            if (pkType.equals("int")) {
                ps.setInt(1, Integer.parseInt(id));
            } else {
                ps.setString(1, id);
            }

            int rows = ps.executeUpdate();

            if (rows > 0) {
                System.out.println("✓ Запись успешно удалена!");
            } else {
                System.out.println("✗ Запись с " + pkColumn + "=" + id + " не найдена!");
            }
        } catch (NumberFormatException e) {
            System.out.println("Ошибка: ID должен быть числом!");
        }
    }

    static void searchRecord(String tableName, String[] columns) throws SQLException {
        System.out.println("\nПо какому полю искать?");
        for (int i = 0; i < columns.length; i++) {
            System.out.println((i+1) + ". " + columns[i]);
        }
        System.out.print("Выберите (1-" + columns.length + "): ");
        int colIndex = scanner.nextInt() - 1;
        scanner.nextLine();

        if (colIndex < 0 || colIndex >= columns.length) {
            System.out.println("Неверный выбор!");
            return;
        }

        System.out.print("Введите значение для поиска: ");
        String value = scanner.nextLine();

        String sql = "SELECT * FROM " + tableName + " WHERE CAST(" + columns[colIndex] + " AS TEXT) ILIKE ?";
        try (Connection conn = DatabaseConnection.getConnection();
             PreparedStatement ps = conn.prepareStatement(sql)) {
            ps.setString(1, "%" + value + "%");
            ResultSet rs = ps.executeQuery();

            ResultSetMetaData meta = rs.getMetaData();
            int colCount = meta.getColumnCount();

            boolean found = false;
            while (rs.next()) {
                found = true;
                for (int i = 1; i <= colCount; i++) {
                    System.out.printf("%-25s", rs.getString(i));
                }
                System.out.println();
            }

            if (!found) {
                System.out.println("Ничего не найдено.");
            }
        }
    }

    static void sortRecords(String tableName, String[] columns) throws SQLException {
        System.out.println("\nПо какому полю сортировать?");
        for (int i = 0; i < columns.length; i++) {
            System.out.println((i+1) + ". " + columns[i]);
