        if (colIndex < 0 || colIndex >= columns.length) {
            System.out.println("Неверный выбор!");
            return;
        }

        System.out.print("1. По возрастанию / 2. По убыванию: ");
        int orderChoice = scanner.nextInt();
        scanner.nextLine();
        String order = (orderChoice == 1) ? "ASC" : "DESC";

        String sql = "SELECT * FROM " + tableName + " ORDER BY " + columns[colIndex] + " " + order;
        try (Connection conn = DatabaseConnection.getConnection();
             Statement stmt = conn.createStatement();
             ResultSet rs = stmt.executeQuery(sql)) {

            ResultSetMetaData meta = rs.getMetaData();
            int colCount = meta.getColumnCount();

            while (rs.next()) {
                for (int i = 1; i <= colCount; i++) {
                    System.out.printf("%-25s", rs.getString(i));
                }
                System.out.println();
            }
        }
    }

    static void createRepairWithParts() {
        System.out.println("\n--- НОВЫЙ РЕМОНТ ---");

        try (Connection conn = DatabaseConnection.getConnection()) {
            conn.setAutoCommit(false);

            System.out.println("\nДоступные автомобили:");
            showAllRecords("cars");
            System.out.print("Введите car_id: ");
            int carId = scanner.nextInt();
            scanner.nextLine();

            System.out.println("\nДоступные неисправности:");
            showAllRecords("malfunctions");
            System.out.print("Введите malfunction_id: ");
            int malfunctionId = scanner.nextInt();
            scanner.nextLine();

            System.out.println("\nДоступные бригады:");
            showAllRecords("brigades");
            System.out.print("Введите brigade_id (0 - не назначать): ");
            int brigadeId = scanner.nextInt();
            scanner.nextLine();

            String sqlRepair = "INSERT INTO repairs (car_id, malfunction_id, brigade_id, start_date, status) VALUES (?, ?, ?, CURRENT_DATE, 'В работе') RETURNING repair_id";
            PreparedStatement psRepair = conn.prepareStatement(sqlRepair);
            psRepair.setInt(1, carId);
            psRepair.setInt(2, malfunctionId);
            if (brigadeId == 0) {
                psRepair.setNull(3, Types.INTEGER);
            } else {
                psRepair.setInt(3, brigadeId);
            }

            ResultSet rs = psRepair.executeQuery();
            rs.next();
            int repairId = rs.getInt(1);
            System.out.println("✓ Ремонт создан, ID = " + repairId);

            System.out.println("\n--- Добавление запчастей ---");
            String sqlPart = "INSERT INTO repair_parts (repair_id, name, quantity, price) VALUES (?, ?, ?, ?)";
            PreparedStatement psPart = conn.prepareStatement(sqlPart);

            int partsCount = 0;
            while (true) {
                System.out.print("\nНазвание запчасти (Enter - завершить): ");
                String name = scanner.nextLine();
                if (name.isEmpty()) break;

                System.out.print("Количество: ");
                int qty = scanner.nextInt();
                System.out.print("Цена за единицу: ");
                double price = scanner.nextDouble();
                scanner.nextLine();

                psPart.setInt(1, repairId);
                psPart.setString(2, name);
                psPart.setInt(3, qty);
                psPart.setDouble(4, price);
                psPart.executeUpdate();
                partsCount++;
                System.out.println("  ✓ Запчасть \"" + name + "\" добавлена");
            }

            conn.commit();
            System.out.println("\n✓✓✓ РЕМОНТ УСПЕШНО СОЗДАН!");
            System.out.println("  ID ремонта: " + repairId);
            System.out.println("  Добавлено запчастей: " + partsCount);
            System.out.println("  Общая стоимость пересчитана триггером");

        } catch (SQLException e) {
            System.out.println("Ошибка: " + e.getMessage());
            System.out.println("Операция отменена.");
        }
    }

