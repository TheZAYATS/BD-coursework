    static void reportRepairCost() throws SQLException {
        System.out.println("\n--- ОТЧЁТ: СТОИМОСТЬ РЕМОНТА ---");
        System.out.print("Фильтр по дате начала (ГГГГ-ММ-ДД, Enter - все): ");
        String dateFilter = scanner.nextLine();

        System.out.println("Сортировка:");
        System.out.println("1. По дате");
        System.out.println("2. По стоимости");
        System.out.print("Выберите: ");
        int sortChoice = scanner.nextInt();
        scanner.nextLine();
        String orderBy = (sortChoice == 1) ? "r.start_date" : "r.total_cost";

        String sql = "SELECT " +
                "r.repair_id, " +
                "c.owner_name, " +
                "c.model, " +
                "m.name AS malfunction, " +
                "r.start_date, " +
                "r.total_cost, " +
                "COALESCE((SELECT SUM(quantity) FROM repair_parts WHERE repair_id = r.repair_id), 0) AS parts_count " +
                "FROM repairs r " +
                "JOIN cars c ON r.car_id = c.car_id " +
                "JOIN malfunctions m ON r.malfunction_id = m.malfunction_id " +
                (dateFilter.isEmpty() ? "" : "WHERE r.start_date >= ?::date ") +
                "ORDER BY " + orderBy + " DESC";

        try (Connection conn = DatabaseConnection.getConnection();
             PreparedStatement ps = conn.prepareStatement(sql)) {

            if (!dateFilter.isEmpty()) {
                ps.setString(1, dateFilter);
            }

            ResultSet rs = ps.executeQuery();

            System.out.printf("\n%-8s %-18s %-15s %-25s %-12s %-12s %-8s%n",
                    "ID", "Владелец", "Модель", "Неисправность", "Дата", "Сумма (руб)", "Деталей");
            System.out.println("=".repeat(110));

            double totalSum = 0;
            int repairCount = 0;
            while (rs.next()) {
                System.out.printf("%-8d %-18s %-15s %-25s %-12s %-12.2f %-8d%n",
                        rs.getInt("repair_id"),
                        truncate(rs.getString("owner_name"), 18),
                        truncate(rs.getString("model"), 15),
                        truncate(rs.getString("malfunction"), 25),
                        rs.getDate("start_date"),
                        rs.getDouble("total_cost"),
                        rs.getInt("parts_count"));
                totalSum += rs.getDouble("total_cost");
                repairCount++;
            }
            System.out.println("=".repeat(110));
            System.out.printf("ИТОГО: %,.2f руб. (ремонтов: %d)%n", totalSum, repairCount);
        }
    }

    static void reportBrigadePerformance() throws SQLException {
        System.out.println("\n--- ОТЧЁТ: ПРОИЗВОДИТЕЛЬНОСТЬ БРИГАД ---");

        String sql = "SELECT " +
                "b.name AS brigade_name, " +
                "COUNT(r.repair_id) AS total_repairs, " +
                "SUM(CASE WHEN r.status = 'Завершен' THEN 1 ELSE 0 END) AS completed, " +
                "ROUND(AVG(r.total_cost), 2) AS avg_cost, " +
                "SUM(r.total_cost) AS total_earned " +
                "FROM brigades b " +
                "LEFT JOIN repairs r ON b.brigade_id = r.brigade_id " +
                "GROUP BY b.brigade_id, b.name " +
                "ORDER BY total_earned DESC";

        try (Connection conn = DatabaseConnection.getConnection();
             Statement stmt = conn.createStatement();
             ResultSet rs = stmt.executeQuery(sql)) {

            System.out.printf("\n%-20s %-10s %-10s %-15s %-15s%n",
                    "Бригада", "Всего", "Завершено", "Средний чек", "Заработано (руб)");
            System.out.println("=".repeat(80));

            while (rs.next()) {
                String brigadeName = rs.getString("brigade_name");
                if (brigadeName == null) brigadeName = "Не назначена";

                System.out.printf("%-20s %-10d %-10d %-15.2f %-15.2f%n",
                        truncate(brigadeName, 20),
                        rs.getInt("total_repairs"),
                        rs.getInt("completed"),
                        rs.getDouble("avg_cost"),
                        rs.getDouble("total_earned"));
            }
        }
    }

